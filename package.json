{
  "name": "hiredvideo-chrome-extension",
  "private": true,
  "version": "2.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Chrome extensions for the hired.video platform: the unified app (job seeker / recruiter / sales & social lenses — ships as the job-seeker Web Store item) plus the legacy Recruiter build.",
  "scripts": {
    "build": "node scripts/build.js",
    "build:app": "node scripts/build.js app",
    "build:recruiter": "node scripts/build.js recruiter",
    "build:icons": "node scripts/build-icons.cjs",
    "pack": "node scripts/pack-crx.js",
    "pack:app": "node scripts/pack-crx.js app",
    "pack:recruiter": "node scripts/pack-crx.js recruiter",
    "release": "node scripts/release.js --build",
    "release:app": "node scripts/release.js app --build",
    "release:recruiter": "node scripts/release.js recruiter --build",
    "watch:app": "node scripts/build.js app --watch",
    "watch:recruiter": "node scripts/build.js recruiter --watch",
    "dev:app": "concurrently -k -n build,web-ext -c blue,green \"npm run watch:app\" \"web-ext run --source-dir=dist/app --target=chromium\"",
    "dev:recruiter": "concurrently -k -n build,web-ext -c blue,green \"npm run watch:recruiter\" \"web-ext run --source-dir=dist/recruiter --target=chromium\"",
    "lint:app": "npm run build:app && web-ext lint --source-dir=dist/app",
    "lint:recruiter": "npm run build:recruiter && web-ext lint --source-dir=dist/recruiter",
    "typecheck": "tsc -p app/tsconfig.json --noEmit",
    "test": "node scripts/run-tests.js"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@types/chrome": "^0.1.0",
    "concurrently": "^9.2.1",
    "crx3": "^2.0.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "web-ext": "^10.1.0"
  },
  "dependencies": {
    "preact": "^10.24.0"
  }
}
