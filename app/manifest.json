{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "hired.video",
  "version": "4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "sidepanel-global.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "profile-parsers.js",
        "content-script-jobs.js",
        "content-script-self-profile.js",
        "content-script-profiles.js",
        "content-script-posts.js",
        "content-script-pill.js"
      ]
    },
    {
      "matches": [
        "https://hired.video/*",
        "https://www.hired.video/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "auth-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
